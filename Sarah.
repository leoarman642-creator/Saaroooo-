<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Happy Birthday Sarah! 💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Playfair+Display:ital,wght@0,600;1,400&family=Patrick+Hand&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      font-family: 'Fredoka', sans-serif;
      background-color: #dbeafe;
      background-image: radial-gradient(#60a5fa 18%, transparent 18%);
      background-size: 28px 28px;
      color: #1e3a8a;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      padding: 15px;
    }

    .container {
      width: 100%;
      max-width: 900px;
      min-height: 560px;
      background: #eff6ff;
      border: 8px solid #ffffff;
      border-radius: 24px;
      box-shadow: 0 20px 40px rgba(30, 58, 138, 0.15);
      position: relative;
      overflow: hidden;
      padding: 30px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    /* Page Sections */
    .page {
      display: none;
      width: 100%;
      height: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      animation: fadeIn 0.5s ease-in-out;
    }

    .page.active {
      display: flex;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.97); }
      to { opacity: 1; transform: scale(1); }
    }

    /* Typography */
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem;
      color: #1e40af;
      margin-bottom: 10px;
    }

    h2 {
      font-size: 2rem;
      color: #2563eb;
      margin-bottom: 15px;
    }

    p {
      font-size: 1.1rem;
      color: #3b82f6;
    }

    /* Buttons */
    .btn {
      background: #3b82f6;
      color: white;
      border: 3px solid #ffffff;
      padding: 12px 28px;
      font-size: 1.2rem;
      font-weight: 700;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(59, 130, 246, 0.4);
      transition: all 0.2s ease;
      margin: 10px;
    }

    .btn:hover {
      transform: translateY(-3px) scale(1.05);
      background: #2563eb;
    }

    .btn-secondary {
      background: #93c5fd;
      color: #1e3a8a;
    }

    /* Sticker / Scrapbook Decorations */
    .tape {
      position: absolute;
      width: 90px;
      height: 25px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px dashed #93c5fd;
      transform: rotate(-5deg);
    }
    .tape-top-left { top: 15px; left: 15px; }
    .tape-top-right { top: 15px; right: 15px; transform: rotate(5deg); }

    /* Polaroid Frames */
    .polaroid {
      background: white;
      padding: 12px 12px 35px 12px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.12);
      border-radius: 4px;
      transform: rotate(-3deg);
      transition: transform 0.3s ease;
      max-width: 280px;
    }

    .polaroid:hover {
      transform: rotate(0deg) scale(1.04);
    }

    .polaroid img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 2px;
    }

    .polaroid .caption {
      font-family: 'Patrick Hand', cursive;
      font-size: 1.4rem;
      color: #1e40af;
      margin-top: 10px;
    }

    /* PAGE 1: Welcome Scrapbook */
    .hero-layout {
      display: flex;
      align-items: center;
      gap: 30px;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* PAGE 2: Candle Blowing */
    .cake-container {
      position: relative;
      cursor: pointer;
      margin: 20px 0;
    }

    .cake-img {
      font-size: 100px;
    }

    .flames {
      position: absolute;
      top: 5px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 12px;
    }

    .flame {
      width: 14px;
      height: 22px;
      background: #ff9800;
      border-radius: 50% 50% 20% 20%;
      box-shadow: 0 0 10px #ff5722;
      animation: flicker 0.6s infinite alternate;
    }

    @keyframes flicker {
      0% { transform: scale(1); }
      100% { transform: scale(1.2); }
    }

    /* PAGE 3: Accept Gifts Modal */
    .cat-badge {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid white;
      box-shadow: 0 6px 15px rgba(0,0,0,0.1);
      margin-bottom: 15px;
    }

    /* PAGE 4: Choose Gift Cards */
    .gifts-grid {
      display: flex;
      gap: 20px;
      margin-top: 25px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .gift-card {
      background: white;
      border: 3px solid #bfdbfe;
      border-radius: 16px;
      padding: 20px;
      width: 160px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .gift-card:hover {
      transform: translateY(-8px);
      border-color: #3b82f6;
      box-shadow: 0 12px 20px rgba(59, 130, 246, 0.2);
    }

    .gift-card span {
      font-size: 50px;
      display: block;
      margin-bottom: 10px;
    }

    /* Gift Views */
    .scrapbook-view {
      display: flex;
      gap: 20px;
      align-items: center;
      max-width: 800px;
      text-align: left;
      flex-wrap: wrap;
    }

    .letter-box {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.06);
      flex: 1;
      min-width: 260px;
      font-family: 'Patrick Hand', cursive;
      font-size: 1.25rem;
      line-height: 1.5;
      color: #1e3a8a;
    }

    .film-strip {
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #1e293b;
      padding: 10px;
      border-radius: 8px;
    }

    .film-strip img {
      width: 180px;
      height: 120px;
      object-fit: cover;
      border-radius: 4px;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="tape tape-top-left"></div>
    <div class="tape tape-top-right"></div>

    <!-- PAGE 1: Intro / Home -->
    <div id="page1" class="page active">
      <div class="hero-layout">
        <div class="polaroid">
          <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r-4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" alt="Couple" id="img1">
          <div class="caption">My Favorite Person 💕</div>
        </div>
        <div>
          <h1>HAPPY BIRTHDAY!</h1>
          <p style="margin-bottom: 20px;">16 November — Celebrating My Special One</p>
          <button class="btn" onclick="goToPage('page2')">Start Celebrating 🎉</button>
        </div>
      </div>
    </div>

    <!-- PAGE 2: Blow Candles -->
    <div id="page2" class="page">
      <h2>Blow out the Candles !!! 🎂</h2>
      <div class="cake-container" onclick="blowCandles()">
        <div class="flames" id="flames">
          <div class="flame"></div>
          <div class="flame"></div>
          <div class="flame"></div>
        </div>
        <div class="cake-img">🎂</div>
      </div>
      <p id="cakeStatus">Click on the cake to blow out candles!</p>
      <button class="btn" id="nextToGiftsBtn" style="display:none; margin-top: 20px;" onclick="goToPage('page3')">Next ➡️</button>
    </div>

    <!-- PAGE 3: Accept Gifts Prompt -->
    <div id="page3" class="page">
      <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r-4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" class="cat-badge" alt="Sarah" id="img2">
      <h2>Accept your gifts? 🎁</h2>
      <div style="margin-top: 15px;">
        <button class="btn" onclick="goToPage('page4')">YES ✨</button>
        <button class="btn btn-secondary" onclick="showTryAgain()">NO 😜</button>
      </div>
    </div>

    <!-- PAGE 3.5: Try Again Popup -->
    <div id="pageTryAgain" class="page">
      <div class="cake-img">🥺</div>
      <h2>Please try again!</h2>
      <p>You can't say NO on your Birthday!</p>
      <button class="btn" onclick="goToPage('page3')">OKAY 💙</button>
    </div>

    <!-- PAGE 4: Gift Selection -->
    <div id="page4" class="page">
      <h2>Yay! Choose your gift 💖</h2>
      <div class="gifts-grid">
        <div class="gift-card" onclick="openGift('gift1')">
          <span>✉️</span>
          <b>Gift 1</b>
          <p style="font-size: 0.9rem;">Love Note</p>
        </div>
        <div class="gift-card" onclick="openGift('gift2')">
          <span>💐</span>
          <b>Gift 2</b>
          <p style="font-size: 0.9rem;">Flowers & Memories</p>
        </div>
        <div class="gift-card" onclick="openGift('gift3')">
          <span>🎁</span>
          <b>Gift 3</b>
          <p style="font-size: 0.9rem;">Birthday Journal</p>
        </div>
      </div>
    </div>

    <!-- GIFT 1: Letter Page -->
    <div id="gift1" class="page">
      <div class="scrapbook-view">
        <div class="letter-box">
          <h3>My Dearest Sarah, 💕</h3>
          <p style="margin-top: 10px;">Happy Birthday to the most amazing person! On 16 November, the world became a much brighter place. Thank you for filling my life with love, smiles, and unforgettable moments.</p>
          <p style="margin-top: 10px;">Forever yours,</p>
          <p><b>Ammu ✨</b></p>
        </div>
        <div class="polaroid">
          <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" id="img3" alt="Memory">
          <div class="caption">Sweet Memories 🌙</div>
        </div>
      </div>
      <button class="btn btn-secondary" style="margin-top:20px;" onclick="goToPage('page4')">⬅️ Back to Gifts</button>
    </div>

    <!-- GIFT 2: Flowers & Filmstrip Page -->
    <div id="gift2" class="page">
      <h2>Some Flowers for you!! 🌸💐</h2>
      <div class="scrapbook-view" style="justify-content: center; margin-top: 15px;">
        <div class="film-strip">
          <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" id="img4" alt="Photo 1">
          <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" id="img5" alt="Photo 2">
        </div>
        <div class="polaroid">
          <img src="https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" id="img6" alt="Flowers">
          <div class="caption">Beautiful as always!</div>
        </div>
      </div>
      <button class="btn btn-secondary" style="margin-top:20px;" onclick="goToPage('page4')">⬅️ Back to Gifts</button>
    </div>

    <!-- GIFT 3: Journal Page -->
    <div id="gift3" class="page">
      <h2>Birthday Girl Journal 📖</h2>
      <div class="letter-box" style="max-width: 600px; text-align: center; margin-top: 15px;">
        <h3>To the Girl Who Makes Every Moment Special ✨</h3>
        <p style="margin-top: 10px;">May your 16th of November birthday be filled with endless laughter, happiness, and all the dreams you wish for.</p>
        <p style="margin-top: 10px; font-weight: bold;">Happy Birthday Sarah! ❤️</p>
      </div>
      <button class="btn btn-secondary" style="margin-top:20px;" onclick="goToPage('page4')">⬅️ Back to Gifts</button>
    </div>

  </div>

  <script>
    // Embedded image URLs directly from your uploaded images
    const userImages = {
      mirror: "https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r", // Mirror image
      guitar: "https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r", // Guitar moonlight image
      solo: "https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r",   // Solo portrait image
      balcony: "https://lh3.googleusercontent.com/proxy/4lD0s1f77d8aM71tX1p-qA916-T-8L46gL31n82j1m349xXbZ9p5r" // Balcony night image
    };

    // Set images on load
    document.getElementById('img1').src = userImages.mirror;
    document.getElementById('img2').src = userImages.solo;
    document.getElementById('img3').src = userImages.guitar;
    document.getElementById('img4').src = userImages.balcony;
    document.getElementById('img5').src = userImages.mirror;
    document.getElementById('img6').src = userImages.solo;

    function goToPage(pageId) {
      document.querySelectorAll('.page').forEach(page => {
        page.classList.remove('active');
      });
      document.getElementById(pageId).classList.add('active');
    }

    function blowCandles() {
      document.getElementById('flames').style.display = 'none';
      document.getElementById('cakeStatus').innerText = 'Yay! Happy Birthdayyy 🥳✨';
      document.getElementById('nextToGiftsBtn').style.display = 'inline-block';
    }

    function showTryAgain() {
      goToPage('pageTryAgain');
    }

    function openGift(giftId) {
      goToPage(giftId);
    }
  </script>
</body>
  </html>
